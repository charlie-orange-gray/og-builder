# ─── Revyme editor - environment ─────────────────────────────────────────────
# No variables are required: without any of these the editor runs fully
# standalone (localStorage persistence, single local user, every core
# editing feature enabled).

# Cloud mode - enables the Revyme cloud backend (auth, server persistence,
# collaboration, CDN component sharing, plans, marketplace). Must be exactly
# the string "true". VITE_API_URL points direct API clients at that backend.
# VITE_REVYME_CLOUD=true
# VITE_API_URL=http://localhost:8090

# Optional third-party media/search keys. Features degrade gracefully when
# unset: the font picker falls back to a built-in list (font LOADING never
# needs a key), the Unsplash/Pixabay search tabs hide (upload + URL paste
# always work).
# VITE_GOOGLE_FONTS_KEY=
# VITE_UNSPLASH_ACCESS_KEY=
# VITE_PIXABAY_KEY=

# AI features (chat panels, page agent, MCP bridge) expect a compatible
# service at this URL (not part of this repo). Leave unset to keep the UI
# inert - it degrades with error toasts, nothing else breaks.
# VITE_AI_SERVICE_URL=http://localhost:8082

# Self-hosted project persistence (independent from publishing).
# Projects are created/listed at / and opened at /builder/<project-id>.
# Start the separate og-control-plane service, then use its explicit development
# session for the local proof. No credentials belong in VITE_* variables.
# Leave VITE_REVYME_CLOUD unset; Cloud retains precedence if both are enabled.
# VITE_SELF_HOSTED_PERSISTENCE=true
# VITE_API_URL=http://localhost:8090

# Self-hosted publishing mode.
# Leave VITE_REVYME_CLOUD unset. During local development, VITE_API_URL is the
# self-hosted control-plane target for same-origin `/api/*` requests. In
# production, route `/api/*` to that service at the reverse proxy instead.
# VITE_SELF_HOSTED_PUBLISH=true
# VITE_API_URL=http://localhost:8090
# Opt into the separate Docker staging deployment request. Keep unset while
# the control-plane worker is not configured; source publication still works.
# VITE_SELF_HOSTED_DOCKER=true

# Self-hosting overrides.
# VITE_CDN_HOST=https://assets.revyme.app
# VITE_PLATFORM_HOST=https://platform.revyme.app
# Comma-separated Host allowlist for `vite preview` behind a proxy.
# VITE_ALLOWED_HOSTS=example.com,.example.com

# Preview server (`npm run dev` boots it on 5175; Next-based page preview
# uses 5173 when running the separate preview project).
# VITE_PREVIEW_HOST=http://localhost:5173
